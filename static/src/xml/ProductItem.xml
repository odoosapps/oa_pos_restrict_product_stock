<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <t t-if="showStock">
                <div t-if="posConfig.stock_check_type == 'on_hand' or posConfig.stock_check_type == 'both_qty'"
                     t-attf-class="oa_stock_badge_onhand {{ stockQtyAvailable lte 0 ? 'oa_stock_depleted' : '' }}">
                    <t t-esc="stockQtyAvailable"/>
                </div>
                <div t-if="posConfig.stock_check_type == 'forecast' or posConfig.stock_check_type == 'both_qty'"
                     t-attf-class="oa_stock_badge_forecast {{ stockVirtualAvailable lte 0 ? 'oa_stock_depleted' : '' }}">
                    <t t-esc="stockVirtualAvailable"/>
                </div>
            </t>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
            <button t-if="!line.comboParent"
                    class="btn btn-link oa_orderline_decrement"
                    t-on-click.stop="() => this.decreaseOrderlineQuantity(line)"
                    title="Decrease quantity"
                    aria-label="Decrease quantity">−</button>
        </xpath>
        <xpath expr="//t[@t-set-slot='details']" position="replace">
            <t t-set-slot="details">
                <button t-if="currentOrder and !currentOrder.is_empty()"
                        class="btn btn-link oa_clear_order_lines"
                        t-on-click="clearOrderLines">
                    Clear All
                </button>
            </t>
        </xpath>
    </t>
</templates>
